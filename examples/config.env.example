# Required URL. Choose exactly one token source below; do not commit a real token.
PAPERLESS_URL=https://paperless.example.test
# PAPERLESS_API_TOKEN=<set in the launching environment>

# The Compose example mounts this path and therefore uses this setting.
PAPERLESS_API_TOKEN_FILE=/run/secrets/paperless_api_token

# Independent capabilities: all remain disabled unless explicitly enabled.
PAPERLESS_MCP_WRITE_ENABLED=false
PAPERLESS_MCP_DELETE_ENABLED=false
PAPERLESS_MCP_ALLOW_TAXONOMY_CREATION=false

# Resource and safety bounds.
PAPERLESS_MCP_MAX_BATCH_SIZE=25
PAPERLESS_MCP_MAX_PAGE_SIZE=100
PAPERLESS_MCP_MAX_CONTENT_CHARACTERS=12000
PAPERLESS_MCP_MAX_NOTES=25
PAPERLESS_MCP_MAX_NOTE_CHARACTERS=2000
PAPERLESS_MCP_REQUEST_TIMEOUT_SECONDS=30
PAPERLESS_MCP_RETRY_ATTEMPTS=3

# Runtime output and transport behavior.
PAPERLESS_MCP_AUDIT_DIR=./data/audit
PAPERLESS_MCP_VERIFY_TLS=true
PAPERLESS_MCP_LOG_LEVEL=INFO

# Workflow safeguards.
PAPERLESS_MCP_PROTECTED_TAGS=Inbox,Needs Review,Important,Retain Original
PAPERLESS_MCP_DEFAULT_REVIEW_TAG=Needs Review
PAPERLESS_MCP_TAXONOMY_POLICY_FILE=./taxonomy-policy.yaml
